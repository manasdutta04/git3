{
  "name": "@git3db/db",
  "version": "0.1.0",
  "description": "Free MongoDB-like database backed by a private GitHub repo",
  "license": "MIT",
  "keywords": [
    "github",
    "database",
    "mongodb",
    "nosql",
    "json",
    "free",
    "git3",
    "serverless"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

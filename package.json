{
  "name": "git3-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter git3 dev",
    "studio": "pnpm --filter git3-studio build && node packages/studio/dist/bin.mjs studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "tsup": "^8.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
